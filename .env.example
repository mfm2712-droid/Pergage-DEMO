# Add these only after Paul approves the provider and the Pergage-owned accounts exist.
# BOOKING_URL=
# CONTACT_EMAIL=engage@pergage.com
# DATABASE_URL=

# Launch gating (read at build time, so a redeploy is needed after any change).
# The site is indexable only when ALL of these hold: SITE_LAUNCH=true, VERCEL_ENV=production
# and NEXT_PUBLIC_SITE_URL is a valid https URL. Otherwise every page is noindex.
# With SITE_LAUNCH=true, `npm run build` is blocked while PROVISIONAL items remain (scripts/check-launch.mjs).
# SITE_LAUNCH=
# NEXT_PUBLIC_SITE_URL=
# Set to "true" only once real analytics exist; it enables the consent banner.
# NEXT_PUBLIC_ANALYTICS_ENABLED=
